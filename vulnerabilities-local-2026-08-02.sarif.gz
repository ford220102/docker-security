              "id": "CVE-2026-50813",
              "name": "CVE-2026-50813",
              "shortDescription": {
                "text": "CVE-2026-50813 in libsqlite3-0"
              },
              "fullDescription": {
                "text": "An issue in SQLite before Fossil check-in 869a51ae84df allows a local attacker to obtain sensitive information via the Session Extension changeset concat/changegroup merge path"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-50813",
