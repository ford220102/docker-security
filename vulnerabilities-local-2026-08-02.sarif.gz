              "shortDescription": {
                "text": "CVE-2023-5388 in libnss3"
              },
              "fullDescription": {
                "text": "NSS was susceptible to a timing side-channel attack when performing RSA decryption. This attack could potentially allow an attacker to recover the private data. This vulnerability affects Firefox < 124, Firefox ESR < 115.9, and Thunderbird < 115.9."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2023-5388",
