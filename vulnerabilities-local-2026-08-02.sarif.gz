            {
              "id": "CVE-2026-5673",
              "name": "CVE-2026-5673",
              "shortDescription": {
                "text": "CVE-2026-5673 in libtheoradec1"
              },
              "fullDescription": {
                "text": "A flaw was found in libtheora. This heap-based out-of-bounds read vulnerability exists within the AVI (Audio Video Interleave) parser, specifically in the avi_parse_input_file() function. A local attacker could exploit this by tricking a user into opening a specially crafted AVI file containing a truncated header sub-chunk. This could lead to a denial-of-service (application crash) or potentially leak sensitive information from the heap."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-5673",
              "defaultConfiguration": {
                "level": "note"
