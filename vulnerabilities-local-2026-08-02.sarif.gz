            {
              "id": "CVE-2026-42504",
              "name": "CVE-2026-42504",
              "shortDescription": {
                "text": "CVE-2026-42504 in stdlib"
              },
              "fullDescription": {
                "text": "Decoding a maliciously-crafted MIME header containing many invalid encoded-words can consume excessive CPU."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-42504",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
