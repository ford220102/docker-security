              "id": "CVE-2026-25680",
              "name": "CVE-2026-25680",
              "shortDescription": {
                "text": "CVE-2026-25680 in golang.org/x/net"
              },
              "fullDescription": {
                "text": "Parsing arbitrary HTML can consume excessive CPU time, possibly leading to denial of service."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-25680",
              "defaultConfiguration": {
                "level": "warning"
