              "name": "CVE-2026-40226",
              "shortDescription": {
                "text": "CVE-2026-40226 in libsystemd0"
              },
              "fullDescription": {
                "text": "In nspawn in systemd 233 through 259 before 260, an escape-to-host action can occur via a crafted optional config file."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-40226",
