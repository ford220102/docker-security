              "id": "CVE-2026-28420",
              "name": "CVE-2026-28420",
              "shortDescription": {
                "text": "CVE-2026-28420 in vim"
              },
              "fullDescription": {
                "text": "Vim is an open source, command line text editor. Prior to version 9.2.0076, a heap-based buffer overflow WRITE and an out-of-bounds READ exist in Vim's terminal emulator when processing maximum combining characters from Unicode supplementary planes. Version 9.2.0076 fixes the issue."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-28420",
              "defaultConfiguration": {
