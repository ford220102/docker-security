              },
              "fullDescription": {
                "text": "Heap Buffer Overflow vulnerability in Libde265 v1.0.15 allows attackers to crash the application via crafted payload to __interceptor_memcpy function."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2024-38950",
