            {
              "id": "GHSA-35p6-xmwp-9g52",
              "name": "GHSA-35p6-xmwp-9g52",
              "shortDescription": {
                "text": "GHSA-35p6-xmwp-9g52 in undici"
              },
              "fullDescription": {
                "text": "undici vulnerable to HTTP response queue poisoning via keep-alive socket reuse"
              },
