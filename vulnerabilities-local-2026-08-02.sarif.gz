            {
              "id": "CVE-2026-56852",
              "name": "CVE-2026-56852",
              "shortDescription": {
                "text": "CVE-2026-56852 in golang.org/x/text"
              },
              "fullDescription": {
                "text": "A norm.Iter can enter an infinite loop when handling input containing invalid UTF-8 bytes."
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2026-56852",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "8.0",
